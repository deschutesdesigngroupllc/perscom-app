APP_NAME="PERSCOM Personnel Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_SCHEME=https
APP_URL=https://app.perscom.test
APP_VERSION=v1.0.0
APP_DESCRIPTION=""

AUTH_URL=https://auth.perscom.test

API_URL=https://api.perscom.test
API_VERSION=v2

#AWS_ACCESS_KEY_ID=herd
#AWS_SECRET_ACCESS_KEY=secretkey
#AWS_DEFAULT_REGION=us-east-1
#AWS_BUCKET=perscom
#AWS_BACKUP_BUCKET=backups
#AWS_USE_PATH_STYLE_ENDPOINT=true
#AWS_ENDPOINT=https://minio.herd.test
#AWS_URL=https://minio.herd.test/perscom

BASE_URL=.perscom.test

BROADCAST_CONNECTION=log

CACHE_STORE=array

CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perscom
DB_USERNAME=root
DB_PASSWORD=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=https://fwd.host/https://auth.perscom.test/discord/callback
DISCORD_BOT_TOKEN=

FASTLY_TOKEN=
FASTLY_SERVICE=

FEATURES_CACHE_STORE=array

FILESYSTEM_DISK=local

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://fwd.host/https://auth.perscom.test/github/callback

GOOGLE_ANALYTICS_TAG=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://fwd.host/https://auth.perscom.test/google/callback

HORIZON_DOMAIN="${APP_URL}"
HORIZON_PATH=horizon

JWT_SECRET=
JWT_ALGO=HS256

LOG_CHANNEL=stack
LOG_STACK=single

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME="${APP_NAME}"
MAIL_ENCRYPTION=null

PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

PENNANT_STORE=array

PULSE_DOMAIN="${APP_URL}"
PULSE_PATH=pulse

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME="https"
PUSHER_APP_CLUSTER="mt1"

QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_BYPASS_HEADER_NAME=X-Perscom-Bypass-Cache
RESPONSE_CACHE_BYPASS_HEADER_VALUE=true

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SLACK_BOT_USER_DEFAULT_CHANNEL=
SLACK_BOT_USER_OAUTH_TOKEN=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PRODUCT_MONTH=
STRIPE_PRODUCT_YEAR=

TELESCOPE_ENABLED=true
TELESCOPE_DOMAIN="${APP_URL}"
TELESCOPE_PATH=telescope

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

VITE_CLOUDFLARE_TURNSTILE_SITE_KEY="${CLOUDFLARE_TURNSTILE_SITE_KEY}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

WIDGET_URL=http://widget.perscom.test:8080/widget.js

# ---------------------------------------------------------------------------
# Container runtime (serversideup/php production image)
# Set these on your PaaS, not in local Herd dev. Defaults are baked into the
# production stage of the Dockerfile; listed here for reference.
# ---------------------------------------------------------------------------
# AUTORUN_ENABLED=true                     # run Laravel automations on boot
# AUTORUN_LARAVEL_MIGRATION=true           # idempotent `migrate --force`, waits for the DB
# AUTORUN_LARAVEL_MIGRATION_ISOLATION=true # --isolated: web/queue/scheduler don't race
# PHP_OPCACHE_ENABLE=1                      # enable OPcache in production
# RUN_SETUP=0                              # set to 1 for a one-time perscom:install (seed + tenant)
