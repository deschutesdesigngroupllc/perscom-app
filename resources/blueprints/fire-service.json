            "name": "Commercial Driver's License (Class B)",
            "type": "license"
        },
        {
            "name": "Fire Officer I",
            "type": "certification"
        }
    ],
    "forms": [
        {
            "name": "Personnel Action Request",
            "description": "Request changes to assignment, shift, classification, or other personnel actions.",
            "instructions": "Submit at least 14 days prior to the desired effective date. Routing:\n\n1. Member completes the request below.\n2. Company Officer endorses.\n3. Battalion Chief reviews and forwards to the Operations Division.\n4. Final approval rests with the Deputy Chief of Operations.",
            "success_message": "Your Personnel Action Request has been submitted and routed to your Company Officer.",
            "is_public": false,
            "fields": [
                {
                    "name": "Member Name",
                    "type": "text",
                    "required": true,
                    "placeholder": "LAST, FIRST MI"
                },
                {
                    "name": "Employee ID",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "Current Rank",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "Station / Shift Assignment",
                    "type": "text",
                    "required": true,
                    "placeholder": "e.g. Station 1 / A-Shift"
                },
                {
                    "name": "Action Type",
                    "type": "select",
                    "required": true,
                    "options": [
                        "Shift Change",
                        "Permanent Trade",
                        "Station Reassignment",
                        "Status Change",
                        "Promotion / Demotion",
                        "Resignation / Retirement",
                        "Other"
                    ]
                },
                {
                    "name": "Effective Date",
                    "type": "date",
                    "required": true
                },
                {
                    "name": "Reason / Justification",
                    "type": "textarea",
                    "required": true
                }
            ]
        },
        {
            "name": "Vacation / Leave Request",
            "description": "Submit requests for vacation, sick, personal leave, or shift trades.",
            "instructions": "Vacation requests must be submitted in accordance with the collective bargaining agreement. Trade requests require the trading member's acknowledgement signature and may not result in overtime.",
            "success_message": "Leave request submitted. Do not modify your shift coverage until the request is approved.",
            "is_public": false,
            "fields": [
                {
                    "name": "Member Name",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "Employee ID",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "Leave Type",
                    "type": "select",
                    "required": true,
                    "options": [
                        "Vacation",
                        "Sick",
                        "Personal",
                        "Comp Time",
                        "Bereavement",
                        "FMLA",
                        "Shift Trade"
                    ]
                },
                {
                    "name": "Start Date",
                    "type": "date",
                    "required": true
                },
                {
                    "name": "End Date",
                    "type": "date",
                    "required": true
                },
                {
                    "name": "Trading With (Member Name)",
                    "type": "text",
                    "required": false,
                    "help": "Leave blank if not a shift trade."
                },
                {
                    "name": "Notes",
                    "type": "textarea",
                    "required": false
                }
            ]
        },
        {
            "name": "Apparatus / Equipment Issue Report",
            "description": "Report damaged, missing, or out-of-service apparatus and equipment so the maintenance division can take action.",
            "instructions": "If the issue places the apparatus out of service, immediately notify the on-duty Battalion Chief in addition to submitting this report.",
            "success_message": "Issue report submitted. The maintenance division will follow up within one business day.",
            "is_public": false,
            "fields": [
                {
                    "name": "Reporting Member",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "Apparatus / Equipment ID",
                    "type": "text",
                    "required": true,
                    "placeholder": "e.g. Engine 1, SCBA #214"
                },
                {
                    "name": "Date Discovered",
                    "type": "date",
                    "required": true
                },
                {
                    "name": "Severity",
                    "type": "select",
                    "required": true,
                    "options": [
                        "Cosmetic",
                        "Functional - In Service",
                        "Out of Service",
                        "Safety Critical"
                    ]
                },
                {
                    "name": "Out of Service?",
                    "type": "boolean",
                    "required": true
                },
                {
                    "name": "Description of Issue",
                    "type": "textarea",
                    "required": true,
                    "help": "Describe the issue, when it was discovered, and any related circumstances."
                },
                {
                    "name": "Photo / Documentation",
                    "type": "file",
                    "required": false
                }
            ]
        },
        {
            "name": "Incident Exposure Report",
            "description": "Report bloodborne pathogen, infectious disease, or hazardous substance exposures sustained on duty.",
            "instructions": "Submit within 24 hours of exposure. Follow up with the department physician for medical evaluation. Confidentiality will be maintained in accordance with HIPAA and department policy.",
            "success_message": "Exposure report submitted. The Safety Officer and department physician have been notified.",
            "is_public": false,
            "fields": [
                {
                    "name": "Member Name",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "Employee ID",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "Incident Number",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "Date / Time of Exposure",
                    "type": "datetime-local",
                    "required": true
                },
                {
                    "name": "Type of Exposure",
                    "type": "select",
                    "required": true,
                    "options": [
                        "Bloodborne Pathogen",
                        "Airborne Pathogen",
                        "Hazardous Material",
                        "Smoke / Products of Combustion",
                        "Sharps / Needlestick",
                        "Other"
                    ]
                },
                {
                    "name": "PPE in Use at Time of Exposure",
                    "type": "textarea",
                    "required": true
                },
                {
                    "name": "Description of Incident",
                    "type": "textarea",
                    "required": true
                },
                {
                    "name": "Sought Medical Evaluation?",
                    "type": "boolean",
                    "required": true
                }
            ]
        },
        {
            "name": "Recruit / Cadet Application",
            "description": "Apply to join the department as a recruit firefighter or cadet.",
            "instructions": "Applicants must be at least 18 years of age, possess a valid driver's license, and pass the CPAT physical ability test prior to academy entry.",
            "success_message": "Thank you for your interest in joining our department. The recruitment division will review your application and contact you regarding next steps.",
            "is_public": true,
            "fields": [
                {
                    "name": "Full Legal Name",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "Email Address",
                    "type": "email",
                    "required": true
                },
                {
                    "name": "Phone Number",
                    "type": "text",
                    "required": true
                },
                {
                    "name": "Date of Birth",
                    "type": "date",
                    "required": true
                },
                {
                    "name": "Current EMS Certification",
                    "type": "select",
                    "required": true,
                    "options": [
                        "None",
                        "EMR",
                        "EMT-Basic",
                        "AEMT",
                        "Paramedic"
                    ]
                },
                {
                    "name": "Currently Certified Firefighter?",
                    "type": "boolean",
                    "required": true
                },
                {
                    "name": "CPAT Card on File?",
                    "type": "boolean",
                    "required": true
                },
                {
                    "name": "Why do you want to join the fire service?",
                    "type": "textarea",
                    "required": true
                },
                {
                    "name": "Resume / Application Packet",
                    "type": "file",
                    "required": false
                }
            ]
        }
    ]
}
